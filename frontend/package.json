    "@mantine/notifications": "7.17.8",
    "@monaco-editor/react": "4.7.0",
    "@tabler/icons-react": "3.34.1",
    "@tanstack/react-query": "5.85.5",
    "@uiw/react-md-editor": "4.0.8",
    "i18next": "24.2.3",
    "monaco-editor": "0.52.2",
    "openapi-fetch": "0.14.1",
