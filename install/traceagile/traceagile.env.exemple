# Configuration de TraceAgile hors Docker (docs/installation.md §4).
# Copier en traceagile.env à côté du jar, adapter, puis protéger le fichier (chmod 600) : il contient des secrets.

# Port HTTP de l'interface et de l'API
SERVER_PORT=8085

# Base PostgreSQL créée par install/base-de-donnees/installer-base.(sh|ps1)
TRACEAGILE_DB_URL=jdbc:postgresql://localhost:5432/traceagile
TRACEAGILE_DB_USER=traceagile
TRACEAGILE_DB_PASSWORD=a-changer

# Secrets : au moins 32 caractères aléatoires chacun (ex. openssl rand -base64 48).
# Ne plus changer TRACEAGILE_ENCRYPTION_KEY une fois des serveurs d'exécution appairés (jetons chiffrés avec).
TRACEAGILE_JWT_SECRET=a-changer-par-une-valeur-aleatoire-de-32-caracteres-ou-plus
TRACEAGILE_ENCRYPTION_KEY=a-changer-par-une-autre-valeur-aleatoire-de-32-caracteres

# Administrateur créé au premier démarrage sur une base vide (ignoré ensuite).
# Sans mot de passe, un mot de passe aléatoire est écrit une fois dans le journal.
TRACEAGILE_ADMIN_LOGIN=admin
TRACEAGILE_ADMIN_PASSWORD=
TRACEAGILE_ADMIN_EMAIL=admin@example.org

# Cookie de rafraîchissement réservé à HTTPS : true derrière un proxy TLS
TRACEAGILE_COOKIE_SECURE=false

# Adresse à laquelle les serveurs d'exécution renvoient leurs résultats : elle doit être joignable
# DEPUIS la machine du serveur d'exécution (nom DNS ou IP de cette machine, pas localhost).
TRACEAGILE_CALLBACK_URL=http://traceagile.example.org:8085/api/v1/execution-callbacks

# Pièces jointes (captures, fichiers) : dossier persistant, à sauvegarder avec la base
TRACEAGILE_ATTACHMENTS_DIR=./pieces-jointes

# Options de la JVM
JAVA_OPTS=-Xmx1g

# --- Installation en conteneur uniquement (docs/installation.md §6) : ce fichier est alors copié en .env ---
# Dans un conteneur, SERVER_PORT est le port publié sur la machine ; TRACEAGILE_ATTACHMENTS_DIR est ignoré
# (volume pieces-jointes).
# Base PostgreSQL dans un conteneur : décommenter la ligne suivante et utiliser
# TRACEAGILE_DB_URL=jdbc:postgresql://postgres:5432/traceagile
#COMPOSE_PROFILES=base-locale
# Adresse donnée au serveur d'exécution de la démo SwagLabs (service installation-demo)
#TRACEAGILE_DEMO_URL_SERVEUR=http://serveur-execution:8091
