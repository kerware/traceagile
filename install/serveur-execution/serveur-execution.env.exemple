# Configuration du serveur d'exécution hors Docker (docs/installation.md §7).
# Copier en serveur-execution.env à côté du jar et adapter. Base H2 embarquée : rien à installer.

SERVER_PORT=8091

# Compte de l'interface web du serveur et de l'appairage depuis TraceAgile : CHANGER le mot de passe
EXECUTION_SERVER_ADMIN_USER=admin
EXECUTION_SERVER_ADMIN_PASSWORD=a-changer

# Données (base H2, espaces de travail, artefacts, journaux) et outils installés depuis l'interface
EXECUTION_SERVER_DATA_DIR=./data
EXECUTION_SERVER_TOOLS_DIR=./tools

# Tests exécutés en parallèle, conservation des jobs (jours), nom affiché dans TraceAgile
EXECUTION_SERVER_AGENTS=4
EXECUTION_SERVER_RETENTION_DAYS=14
EXECUTION_SERVER_NAME=executeur-1

JAVA_OPTS=-Xmx512m

# --- Installation en conteneur uniquement (docs/installation.md §8) : ce fichier est alors copié en .env ---
# SERVER_PORT est le port publié sur la machine ; EXECUTION_SERVER_DATA_DIR et EXECUTION_SERVER_TOOLS_DIR
# sont ignorés (volumes donnees et outils).
